{
  "name": "dns-check",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "TURNSTILE_SITEKEY": "0x4AAAAAAGHUgTKXn-6CXYNS" },
  "routes": [{ "pattern": "dns.peacock665.co.uk", "custom_domain": true }]
}
